        {
            "techniqueID": "T1003.001",
            "enabled": true,
            "queries": [
                {
                    "id": "q-test-1",
                    "name": "OS Credential Dumping Detection",
                    "language": "splunk",
                    "query": "index=windows EventCode=4624 LogonType=3 | stats count by user",
                    "description": "Detects credential dumping via LSASS",
                    "source": "Test Rule"
                }
            ]
        },
